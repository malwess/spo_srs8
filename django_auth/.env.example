# Пример переменных окружения. Скопируйте файл в .env и при необходимости измените значения.
# Файл .env в репозиторий не добавляется (.gitignore). Настоящие секреты здесь не хранятся.

# Секретный ключ Django. Для своего компьютера — любая длинная строка,
# на сервере — случайное значение (на Render: кнопка Generate)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# True — режим разработки на своём компьютере, False — на публичном сервере
DJANGO_DEBUG=True

# Домены, на которых работает сайт (через запятую, без https://)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Полные адреса сайта для проверки CSRF (с протоколом)
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

# False — сайт открывается по http (свой компьютер), True — только по https (сервер)
DJANGO_HTTPS=False

# Адрес базы данных. Если не задан — используется SQLite-файл db.sqlite3.
# На Render сюда подставляется Internal Database URL базы PostgreSQL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
